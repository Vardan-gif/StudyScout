# StudyScout environment configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Port for the Express server (default: 3000)
PORT=3000

# Optional: Gemini API key for LLM-powered concept mapping and ranking.
# If not set, StudyScout uses rule-based heuristics instead.
GEMINI_API_KEY=

# Optional: Timeout in seconds for each webcmd fetch call (default: 30)
WEBCMD_FETCH_TIMEOUT=30

# Optional: Maximum characters returned per webcmd fetch (default: 15000)
WEBCMD_MAX_CHARS=15000
